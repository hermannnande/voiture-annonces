generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id          BigInt   @id @default(autoincrement())
  actor_id    String?
  action      String
  target_type String
  target_id   String
  meta        Json?
  ip          String?
  created_at  DateTime @default(now())
  users       users?   @relation(fields: [actor_id], references: [id])

  @@index([action])
  @@index([actor_id])
  @@index([created_at])
}

model boost_products {
  id            Int         @id @default(autoincrement())
  name          String
  description   String?
  duration_days Int
  priority      Int         @default(0)
  price_fcfa    BigInt
  credits_cost  BigInt      @default(0)
  effect        BoostEffect @default(TOP)
  is_active     Boolean     @default(true)
  features      Json?
  boosts        boosts[]
}

model boosts {
  id               String         @id
  listing_id       String
  boost_product_id Int
  buyer_id         String?
  starts_at        DateTime
  ends_at          DateTime
  payment_status   String         @default("COMPLETED")
  payment_amount   BigInt         @default(0)
  payment_provider String?
  created_at       DateTime       @default(now())
  boost_products   boost_products @relation(fields: [boost_product_id], references: [id])
  users            users?         @relation(fields: [buyer_id], references: [id])
  listings         listings       @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  @@index([buyer_id])
  @@index([ends_at])
  @@index([listing_id])
}

model brands {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  slug       String     @unique
  created_at DateTime   @default(now())
  listings   listings[]
  models     models[]
}

model categories {
  id               Int          @id @default(autoincrement())
  name             String
  slug             String       @unique
  parent_id        Int?
  created_at       DateTime     @default(now())
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onDelete: Cascade)
  other_categories categories[] @relation("categoriesTocategories")
  listings         listings[]
}

model favorites {
  id         String   @id
  user_id    String
  listing_id String
  created_at DateTime @default(now())
  listings   listings @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, listing_id])
}

model listing_images {
  id         Int      @id @default(autoincrement())
  listing_id String
  url        String
  sort       Int      @default(0)
  created_at DateTime @default(now())
  listings   listings @relation(fields: [listing_id], references: [id], onDelete: Cascade)
}

model listings {
  id                 String           @id
  user_id            String
  title              String
  description        String
  price_fcfa         BigInt
  state              ListingState
  fuel               FuelType
  gearbox            GearboxType
  year               Int
  mileage_km         Int
  color              String
  doors              Int?
  power_cv           Int?
  chassis_number     String?
  brand_id           Int
  model_id           Int?
  category_id        Int
  location_country   String           @default("Côte d'Ivoire")
  location_city      String
  status             ListingStatus    @default(EN_ATTENTE)
  rejection_reason   String?
  is_sponsored       Boolean          @default(false)
  sponsored_until    DateTime?
  sponsored_priority Int              @default(0)
  view_count         Int              @default(0)
  created_at         DateTime         @default(now())
  updated_at         DateTime
  boosts             boosts[]
  favorites          favorites[]
  listing_images     listing_images[]
  brands             brands           @relation(fields: [brand_id], references: [id])
  categories         categories       @relation(fields: [category_id], references: [id])
  models             models?          @relation(fields: [model_id], references: [id])
  users              users            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  reports            reports[]
  threads            threads[]

  @@index([brand_id])
  @@index([category_id])
  @@index([created_at])
  @@index([is_sponsored])
  @@index([location_city])
  @@index([price_fcfa])
  @@index([status])
}

model messages {
  id         String   @id
  thread_id  String
  sender_id  String
  body       String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  users      users    @relation(fields: [sender_id], references: [id], onDelete: Cascade)
  threads    threads  @relation(fields: [thread_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([thread_id])
}

model models {
  id         Int        @id @default(autoincrement())
  brand_id   Int
  name       String
  slug       String
  created_at DateTime   @default(now())
  listings   listings[]
  brands     brands     @relation(fields: [brand_id], references: [id], onDelete: Cascade)

  @@unique([brand_id, name])
}

model refresh_tokens {
  id         String   @id
  token      String   @unique
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model reports {
  id         String   @id
  user_id    String
  listing_id String
  reason     String
  status     String   @default("PENDING")
  admin_note String?
  created_at DateTime @default(now())
  updated_at DateTime
  listings   listings @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model threads {
  id                             String     @id
  listing_id                     String
  buyer_id                       String
  seller_id                      String
  created_at                     DateTime   @default(now())
  updated_at                     DateTime
  messages                       messages[]
  users_threads_buyer_idTousers  users      @relation("threads_buyer_idTousers", fields: [buyer_id], references: [id], onDelete: Cascade)
  listings                       listings   @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  users_threads_seller_idTousers users      @relation("threads_seller_idTousers", fields: [seller_id], references: [id], onDelete: Cascade)

  @@unique([listing_id, buyer_id])
}

model users {
  id                               String                @id
  role                             UserRole              @default(SELLER)
  name                             String
  email                            String                @unique
  phone                            String?
  password_hash                    String?
  is_active                        Boolean               @default(true)
  is_email_verified                Boolean               @default(false)
  email_verification_token         String?
  email_verification_expires       DateTime?
  password_reset_token             String?
  password_reset_expires           DateTime?
  google_id                        String?               @unique
  created_at                       DateTime              @default(now())
  updated_at                       DateTime
  audit_logs                       audit_logs[]
  boosts                           boosts[]
  favorites                        favorites[]
  listings                         listings[]
  messages                         messages[]
  refresh_tokens                   refresh_tokens[]
  reports                          reports[]
  threads_threads_buyer_idTousers  threads[]             @relation("threads_buyer_idTousers")
  threads_threads_seller_idTousers threads[]             @relation("threads_seller_idTousers")
  wallet_transactions              wallet_transactions[]
  wallets                          wallets?
}

model wallet_transactions {
  id                  String                @id
  wallet_id           String
  type                WalletTransactionType
  amount              BigInt
  reason              String?
  related_entity_type String?
  related_entity_id   String?
  actor_id            String?
  created_at          DateTime              @default(now())
  users               users?                @relation(fields: [actor_id], references: [id])
  wallets             wallets               @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@index([actor_id])
  @@index([created_at])
  @@index([wallet_id])
}

model wallets {
  id                  String                @id
  user_id             String                @unique
  balance_credits     BigInt                @default(0)
  created_at          DateTime              @default(now())
  updated_at          DateTime
  wallet_transactions wallet_transactions[]
  users               users                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum BoostEffect {
  TOP
  SEARCH_PRIORITY
  HOME_PREMIUM
}

enum FuelType {
  ESSENCE
  DIESEL
  HYBRIDE
  ELECTRIQUE
}

enum GearboxType {
  MANUELLE
  AUTOMATIQUE
}

enum ListingState {
  NEUF
  OCCASION
}

enum ListingStatus {
  BROUILLON
  EN_ATTENTE
  APPROUVEE
  REFUSEE
  VENDU
}

enum UserRole {
  SELLER
  SUPER_ADMIN
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}
